diff --git a/kintree/common/barcode.py b/kintree/common/barcode.py
new file mode 100644
index 0000000..043e4b1
--- /dev/null
+++ b/kintree/common/barcode.py
@@ -0,0 +1,227 @@
+"""Barcode parsing module for supplier barcodes.
+
+Supports parsing of 2D barcodes (DataMatrix, QR) from:
+- DigiKey (ECIA 2D format)
+- Mouser (ECIA 2D format)
+- LCSC (QR code with custom format)
+
+Based on ECIA specification:
+https://www.ecianow.org/assets/docs/ECIA_Specifications.pdf
+"""
+
+import re
+from typing import Optional
+from dataclasses import dataclass
+
+from .tools import cprint
+
+
+@dataclass
+class BarcodeData:
+    """Parsed barcode data."""
+    supplier: Optional[str] = None
+    supplier_part_number: Optional[str] = None
+    manufacturer_part_number: Optional[str] = None
+    quantity: Optional[int] = None
+    purchase_order: Optional[str] = None
+    lot_code: Optional[str] = None
+    country_of_origin: Optional[str] = None
+    raw_data: str = ''
+    
+    def is_valid(self) -> bool:
+        """Check if barcode contains minimum required data."""
+        return bool(self.supplier_part_number or self.manufacturer_part_number)
+
+
+# ECIA field identifiers mapping
+# Ref: https://www.ecianow.org/assets/docs/ECIA_Specifications.pdf
+ECIA_FIELD_MAP = {
+    'P': 'supplier_part_number',      # Supplier/Customer Part Number
+    '1P': 'manufacturer_part_number',  # Manufacturer Part Number
+    'Q': 'quantity',                   # Quantity
+    'K': 'purchase_order',             # Customer PO Number
+    '1K': 'sales_order',               # Supplier Sales Order
+    '10K': 'invoice',                  # Invoice Number
+    '1T': 'lot_code',                  # Lot/Batch Code
+    '4L': 'country_of_origin',         # Country of Origin
+    '9D': 'date_code',                 # Date Code
+}
+
+# ECIA 2D barcode format constants
+ECIA_HEADER = '[)>\x1e06\x1d'
+ECIA_HEADER_ALT = '[)>\x1e06'  # Some barcodes omit the trailing GS
+OLD_MOUSER_HEADER = '>[)>06\x1d'
+ECIA_TRAILER = '\x1e\x04'
+ECIA_DELIMITER = '\x1d'  # GS (Group Separator)
+ECIA_RS = '\x1e'  # RS (Record Separator)
+
+# LCSC QR code pattern: {key:value,key:value,...}
+LCSC_PATTERN = re.compile(r'^\{((?:[^:,]+:[^:,]*,)*(?:[^:,]+:[^:,]*))\}$')
+LCSC_FIELD_MAP = {
+    'pm': 'manufacturer_part_number',  # Part MPN
+    'pc': 'supplier_part_number',      # Part Code (LCSC number like C312270)
+    'qty': 'quantity',                 # Quantity
+    'on': 'purchase_order',            # Order Number
+    'pbn': 'pick_batch',               # Pick batch number
+}
+
+
+def parse_ecia_barcode(barcode_data: str) -> dict:
+    """Parse ECIA 2D barcode format (used by DigiKey, Mouser, etc.).
+    
+    Args:
+        barcode_data: Raw barcode string
+        
+    Returns:
+        Dict with parsed fields, empty if not ECIA format
+    """
+    # Handle legacy Mouser format
+    if barcode_data.startswith(OLD_MOUSER_HEADER):
+        barcode_data = barcode_data.replace(OLD_MOUSER_HEADER, ECIA_HEADER, 1)
+    
+    # Check for ECIA header
+    if barcode_data.startswith(ECIA_HEADER):
+        data = barcode_data[len(ECIA_HEADER):]
+    elif barcode_data.startswith(ECIA_HEADER_ALT):
+        data = barcode_data[len(ECIA_HEADER_ALT):]
+    else:
+        return {}
+    
+    # Remove trailer if present
+    if ECIA_TRAILER in data:
+        data = data[:data.index(ECIA_TRAILER)]
+    elif data.endswith(ECIA_RS):
+        data = data[:-1]
+    
+    # Split into fields
+    fields_raw = data.split(ECIA_DELIMITER)
+    
+    result = {}
+    for field in fields_raw:
+        if not field:
+            continue
+        # Match against known field identifiers (longest first)
+        for identifier in sorted(ECIA_FIELD_MAP.keys(), key=len, reverse=True):
+            if field.startswith(identifier):
+                field_name = ECIA_FIELD_MAP[identifier]
+                value = field[len(identifier):]
+                result[field_name] = value
+                break
+    
+    return result
+
+
+def parse_lcsc_barcode(barcode_data: str) -> dict:
+    """Parse LCSC QR code format.
+    
+    LCSC uses format: {pbn:PICK123,on:SO123,pc:C312270,pm:MPN123,qty:100}
+    
+    Args:
+        barcode_data: Raw barcode string
+        
+    Returns:
+        Dict with parsed fields, empty if not LCSC format
+    """
+    match = LCSC_PATTERN.match(barcode_data)
+    if not match:
+        return {}
+    
+    content = match.group(1)
+    result = {}
+    
+    for pair in content.split(','):
+        if ':' not in pair:
+            continue
+        key, value = pair.split(':', 1)
+        if key in LCSC_FIELD_MAP:
+            result[LCSC_FIELD_MAP[key]] = value
+    
+    return result
+
+
+def detect_supplier_from_barcode(barcode_data: str, parsed_fields: dict) -> Optional[str]:
+    """Detect supplier from barcode format and content.
+    
+    Args:
+        barcode_data: Raw barcode string
+        parsed_fields: Already parsed fields dict
+        
+    Returns:
+        Supplier name or None
+    """
+    # LCSC format is distinctive
+    if LCSC_PATTERN.match(barcode_data):
+        return 'LCSC'
+    
+    # Check ECIA format
+    is_ecia = (
+        barcode_data.startswith(ECIA_HEADER) or 
+        barcode_data.startswith(ECIA_HEADER_ALT) or
+        barcode_data.startswith(OLD_MOUSER_HEADER)
+    )
+    
+    if is_ecia:
+        spn = parsed_fields.get('supplier_part_number', '')
+        
+        # DigiKey SKUs typically have format like: 296-1000-1-ND, ABC123-ND
+        if spn.endswith('-ND') or spn.endswith('-1-ND') or spn.endswith('-2-ND') or spn.endswith('-3-ND'):
+            return 'Digi-Key'
+        
+        # Mouser SKUs are typically numeric or alphanumeric without special suffix
+        # This is a fallback - Mouser barcodes use ECIA format
+        if spn and not spn.endswith('-ND'):
+            return 'Mouser'
+    
+    return None
+
+
+def parse_barcode(barcode_data: str) -> BarcodeData:
+    """Parse a supplier barcode and extract relevant data.
+    
+    Attempts to parse as:
+    1. ECIA 2D format (DigiKey, Mouser)
+    2. LCSC QR format
+    
+    Args:
+        barcode_data: Raw barcode string (may contain control characters)
+        
+    Returns:
+        BarcodeData with parsed fields
+    """
+    result = BarcodeData(raw_data=barcode_data)
+    
+    # Try ECIA format first (most common for electronics suppliers)
+    fields = parse_ecia_barcode(barcode_data)
+    
+    # If not ECIA, try LCSC
+    if not fields:
+        fields = parse_lcsc_barcode(barcode_data)
+    
+    if not fields:
+        cprint(f'[BARCODE] Warning: Could not parse barcode format')
+        return result
+    
+    # Map parsed fields to BarcodeData
+    result.supplier_part_number = fields.get('supplier_part_number')
+    result.manufacturer_part_number = fields.get('manufacturer_part_number')
+    result.purchase_order = fields.get('purchase_order')
+    result.lot_code = fields.get('lot_code')
+    result.country_of_origin = fields.get('country_of_origin')
+    
+    # Parse quantity as integer
+    qty_str = fields.get('quantity')
+    if qty_str:
+        try:
+            result.quantity = int(qty_str)
+        except ValueError:
+            cprint(f'[BARCODE] Warning: Could not parse quantity: {qty_str}')
+    
+    # Detect supplier
+    result.supplier = detect_supplier_from_barcode(barcode_data, fields)
+    
+    cprint(f'[BARCODE] Parsed: supplier={result.supplier}, '
+           f'SKU={result.supplier_part_number}, '
+           f'MPN={result.manufacturer_part_number}, '
+           f'qty={result.quantity}')
+    
+    return result
