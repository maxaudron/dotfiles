+    
+    def process_barcode(self, e):
+        """Process scanned barcode and populate fields."""
+        barcode_data = self.fields['barcode'].value
+        if not barcode_data:
+            return
+        
+        # Parse the barcode
+        parsed = parse_barcode(barcode_data)
+        
+        if not parsed.is_valid():
+            self.show_dialog(
+                d_type=DialogType.ERROR,
+                message='Could not parse barcode format',
+            )
+            self.fields['barcode'].value = ''
+            self.fields['barcode'].focus()
+            self._page.update()
+            return
+        
+        # Set supplier if detected
+        if parsed.supplier:
+            # Find matching supplier in dropdown
+            supplier_matched = False
+            for option in self.fields['supplier'].options:
+                if parsed.supplier.lower() in option.key.lower():
+                    self.fields['supplier'].value = option.key
+                    supplier_matched = True
+                    break
+            if not supplier_matched:
+                self.show_dialog(
+                    d_type=DialogType.WARNING,
+                    message=f'Detected supplier "{parsed.supplier}" not found in enabled suppliers',
+                )
+        
+        # Set part number (prefer supplier part number, fall back to MPN)
+        part_number = parsed.supplier_part_number or parsed.manufacturer_part_number
+        if part_number:
+            self.fields['part_number'].value = part_number
+        
+        # Store quantity for InvenTree view
+        if parsed.quantity:
+            self.barcode_quantity = parsed.quantity
+            # Store in shared data for InvenTree view to pick up
+            data_from_views['_barcode_quantity'] = parsed.quantity
+        
+        # Clear barcode field for next scan
+        self.fields['barcode'].value = ''
+        self._page.update()
+        
+        # Auto-trigger search if we have both part number and supplier
+        if self.fields['part_number'].value and self.fields['supplier'].value:
+            self.run_search(e)
+        else:
+            self.show_dialog(
+                d_type=DialogType.WARNING,
+                message=f'Parsed: SKU={parsed.supplier_part_number}, MPN={parsed.manufacturer_part_number}, Qty={parsed.quantity}. Please select supplier and submit.',
+            )
+        
+        # Focus barcode field for next scan
+        try:
+            self.fields['barcode'].focus()
+        except AssertionError:
+            pass
 
