 namespace fs = boost::filesystem;
 
+// boost::filesystem::copy() preserves source permissions; read-only store
+// directories (0555, e.g. the Nix store) would produce an unwritable
+// destination tree, so copy the entries one by one instead.
+static void copy_tree_keep_writable(const fs::path& src, const fs::path& dst)
+{
+    boost::system::error_code ec;
+    if (fs::is_regular_file(src, ec)) {
+        fs::copy_file(src, dst, fs::copy_options::overwrite_existing, ec);
+        if (!ec)
+            fs::permissions(dst, fs::owner_read | fs::owner_write, ec);
+        return;
+    }
+    if (!fs::is_directory(src, ec))
+        return;
+    fs::create_directories(dst, ec);
+    for (const auto& entry : fs::recursive_directory_iterator(src)) {
+        const auto rel = fs::relative(entry.path(), src);
+        boost::system::error_code ecp;
+        if (entry.is_directory()) {
+            fs::create_directories(dst / rel, ecp);
+        } else if (entry.is_regular_file()) {
+            fs::create_directories((dst / rel).parent_path(), ecp);
+            fs::copy_file(entry.path(), dst / rel, fs::copy_options::overwrite_existing, ecp);
+            if (!ecp)
+                fs::permissions(dst / rel, fs::owner_read | fs::owner_write, ecp);
+        }
+    }
+}
